# Copy this file to /opt/backend-legacy/.env on the host.
# The systemd template loads that path via:
#   EnvironmentFile=-/opt/backend-legacy/.env
CADAGENT_AUTH_BYPASS=false
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
ROUTER_MODEL=gpt-4.1-nano
# Set ROUTER_MODEL=minimax.minimax-m2.5 to route prompt classification through Amazon Bedrock.
# When using MiniMax, provide the Bedrock API key via AWS_BEARER_TOKEN_BEDROCK.
ROUTER_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
AWS_BEARER_TOKEN_BEDROCK=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MAX_WEBSOCKET_CONNECTIONS=200
MAX_HISTORY_MESSAGES=200
RATE_LIMIT_REQUESTS_PER_MINUTE=200
RATE_LIMIT_BURST_CAPACITY=50
RATE_LIMIT_TOKENS_PER_DAY=500000
ENABLE_RATE_LIMITING=true
MAX_ITERATIONS=30
EXECUTION_TIMEOUT=30
PLAN_APPROVAL_TIMEOUT=120
USE_PROMPT_ROUTING=true
BYPASS_SUPABASE_GATEWAY=false
CADAGENT_STRICT_SCHEMA=false
