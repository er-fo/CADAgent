{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::cadagent-backend-legacy-deploy-598566032640/backend-legacy/*"
      ]
    },
    {
      "Sid": "ListDeploymentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::cadagent-backend-legacy-deploy-598566032640",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "backend-legacy/*"
          ]
        }
      }
    }
  ]
}
