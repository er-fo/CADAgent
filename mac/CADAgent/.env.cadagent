# CADAgent local codex-lb harness environment.
# No private inference key is stored in the add-in; the local backend owns CODEX_LB_API_KEY.
CADAGENT_AUTH_BYPASS="true"
CADAGENT_LOCAL_CODEX_LB="true"

# Backend WebSocket configuration - connect to local backend.
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
BACKEND_USE_SSL="false"
